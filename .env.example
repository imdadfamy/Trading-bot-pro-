# Backend local only. Generate your own random key; never commit actual values.
TIP_DB=data/trading.db
TIP_OPERATOR_KEY=
# Optional server-only integrations. Leave empty until you choose providers.
OPENAI_API_KEY=
# Model prices in USD per million tokens, copied from the provider's price list. No default is assumed;
# model-backed analysis refuses to run until both are set.
TIP_OPENAI_INPUT_USD_PER_M=
TIP_OPENAI_OUTPUT_USD_PER_M=
TIP_NEWSAPI_KEY=
TIP_TRADING_ECONOMICS_KEY=
TIP_MT5_DEMO_LOGIN=
TIP_MT5_DEMO_SERVER=
# Frontend (web/.env.local): NEXT_PUBLIC_API_URL=http://localhost:8000
# Future provider secrets are server-side only; no broker credentials in this file.
